{
  "name": "daily",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @daily/web dev",
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "visual:capture": "pnpm --filter @daily/web visual:capture",
    "e2e": "pnpm --filter @daily/web e2e",
    "visual:app": "pnpm --filter @daily/web visual:app",
    "visual:focus": "pnpm --filter @daily/web visual:focus",
    "visual:stats": "pnpm --filter @daily/web visual:stats",
    "visual:habits": "pnpm --filter @daily/web visual:habits",
    "visual:views": "pnpm --filter @daily/web visual:views",
    "visual:layout": "pnpm --filter @daily/web visual:layout"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
